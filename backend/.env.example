# Шаблон окружения бэкенда. Скопируйте в .env при необходимости.
# Все переменные имеют значения по умолчанию — сервис стартует без .env.

# Строка подключения SQLAlchemy (MVP — SQLite, ADR-0001)
DIVCAL_DATABASE_URL=sqlite:///./divcal.db

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
DIVCAL_LOG_LEVEL=INFO

# Граница зоны `near` статуса сторожка, суток
DIVCAL_WATCH_SOON_DAYS=14

# Граница зоны `hot` по умолчанию для нового сторожка, суток
DIVCAL_WATCH_DEFAULT_THRESHOLD_DAYS=7

# Таймаут HTTP-запросов скриптов сбора к источникам, секунд
DIVCAL_HTTP_TIMEOUT_SECONDS=30

# Количество повторных попыток запросов скриптов сбора
DIVCAL_HTTP_RETRIES=3
